import seaborn as sns, pandas as pd, matplotlib.pyplot as plt

# Load Titanic dataset once
df = sns.load_dataset("titanic")
df.to_csv("titanic.csv", index=False)  # offline fallback

# Profiling
print(df.info())
print(df.describe())
print("Shape:", df.shape)

# Missing values %
missing = df.isnull().mean()*100
print(missing[missing>0])

# Apply threshold rule
# <5% drop rows, 5–30% impute, >30% drop/encode/drop column
# Example: Age ~20% missing → impute median
df["age"].fillna(df["age"].median(), inplace=True)

# Univariate analysis
plt.hist(df["age"].dropna()); plt.title("Age Histogram"); plt.show()
plt.boxplot(df["fare"].dropna()); plt.title("Fare Boxplot"); plt.show()

# IQR outliers
Q1, Q3 = df["fare"].quantile([0.25,0.75])
IQR = Q3-Q1
outliers = ((df["fare"] < Q1-1.5*IQR) | (df["fare"] > Q3+1.5*IQR)).sum()
print("Fare outliers:", outliers)

# Bivariate survival rates
print(df.groupby("sex")["survived"].mean())
print(df.groupby("pclass")["survived"].mean())
print(df.groupby(["sex","pclass"])["survived"].mean())

# Correlation matrix (6 cols)
cols = ["survived","pclass","age","sibsp","parch","fare"]
corr = df[cols].corr()
sns.heatmap(corr, annot=True, cmap="coolwarm")
plt.show()
